{
  "name": "@crosschat/realtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/db.ts"
  },
  "dependencies": {
    "@crosschat/core": "workspace:*",
    "arctic": "^3.7.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "socket.io": "^4.8.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.1",
    "@types/node": "^22.7.4",
    "socket.io-client": "^4.7.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
