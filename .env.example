# ---------------- Server ----------------
PORT=8362
APP_URL_LOCAL=http://localhost:8362
APP_URL_PROD=https://crosschat.humananomaly.xyz
REALTIME_URL=http://localhost:8362

# ---------------- Google OAuth ----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------- Core / Storage ----------------
# SESSION_SECRET: auto-filled by pnpm generate:secrets
SESSION_SECRET=
DATABASE_PATH=./data/crosschat.db
MEDIA_DIR=./data/media

# ---------------- Telegram ----------------
# TELEGRAM_BOT_TOKEN: from @BotFather, e.g.: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=

# Public Telegram bot link (from @BotFather), e.g.: https://t.me/your_bot
TELEGRAM_BOT_URL=https://t.me/trycrosschat_bot

# Bot -> backend auth secret (filled by generate:secrets). Also used as x-bot-secret.
TELEGRAM_WEBHOOK_SECRET=

# Mode: webhook (prod default) | polling (dev default). Empty = auto.
TELEGRAM_MODE=
TELEGRAM_LOCALE=en
TELEGRAM_URL=http://localhost:8364
TELEGRAM_PORT=8364

# ---------------- Discord ----------------
DISCORD_BOT_TOKEN=

# Example: https://discord.com/oauth2/authorize?client_id=123456789012345678&permissions=3072&scope=bot%20applications.commands
DISCORD_INVITE_URL=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Empty = falls back to TELEGRAM_WEBHOOK_SECRET (x-bot-secret).
DISCORD_WEBHOOK_SECRET=

DISCORD_LOCALE=en
DISCORD_URL=http://localhost:8365
DISCORD_PORT=8365

# ---------------- WhatsApp ----------------
WHATSAPP_SESSION=wa
WHATSAPP_DATA_DIR=./data/whatsapp
WHATSAPP_URL=http://localhost:8366
WHATSAPP_PORT=8366
WHATSAPP_LOCALE=en
# Pair with 8-char code
WHATSAPP_PAIR_WITH_CODE=true
# Empty = falls back to TELEGRAM_WEBHOOK_SECRET (x-bot-secret).
WHATSAPP_WEBHOOK_SECRET=
# Optional public contact, e.g.: https://wa.me/6281234567890
WHATSAPP_ENTRY_URL=https://wa.me/6285196519731

# ---------------- Tuning (optional) ----------------
# Keep defaults unless you know what you are doing.
PAIR_CODE_TTL_SEC=300
PAIR_RATE_LIMIT_MAX=5
MEDIA_MAX_BYTES=20971520
